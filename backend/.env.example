PORT=5000

# Option A: hosted Postgres (Neon, Supabase, Render, etc.) — set this and
# the DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD vars below are ignored.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Option B: local/self-hosted Postgres via discrete vars (used only if
# DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transitops
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
